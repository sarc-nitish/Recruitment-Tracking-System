              "raw": "{\n  \"name\": \"Ravi Recruiter\",\n  \"email\": \"{{recruiterEmail}}\",\n  \"password\": \"{{recruiterPassword}}\",\n  \"role\": \"RECRUITER\",\n  \"companyName\": \"Infosys\"\n}",

spring.application.name=Recruitment Tracking System
server.port=8080

# ===== MySQL (copy this file to application.properties and put your own MySQL password) =====
# The database is created automatically if it does not exist.
spring.datasource.url=jdbc:mysql://localhost:3306/rts_rest_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your_mysql_password_here

# ===== JPA / Hibernate: tables are created/updated automatically =====
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false